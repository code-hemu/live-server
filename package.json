{
  "name": "live-server-guchho",
  "displayName": "Live Server (Guchho)",
  "description": "Preview HTML pages locally with Guchho.",
  "version": "0.0.1",
  "publisher": "codehemu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-hemu/live-server"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "icon": "resources/logo.png",
  "contributes": {
    "commands": [
      {
        "command": "liveServerGuchho.startServer",
        "title": "Live Server: Open with Live Server"
      },
      {
        "command": "liveServerGuchho.stopServer",
        "title": "Live Server: Stop Live Server"
      },
      {
        "command": "liveServerGuchho.restartServer",
        "title": "Live Server: Restart Live Server"
      },
      {
        "command": "liveServerGuchho.openInBrowser",
        "title": "Live Server: Open in Browser"
      },
      {
        "command": "liveServerGuchho.toggleServer",
        "title": "Live Server: Toggle Live Server"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "liveServerGuchho.startServer",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "liveServerGuchho.startServer",
          "when": "editorLangId == html",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "liveServerGuchho.startServer",
          "when": "editorLangId == html",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "alt+l alt+o",
        "mac": "cmd+l cmd+o",
        "command": "liveServerGuchho.startServer",
        "when": "editorTextFocus"
      },
      {
        "key": "alt+l alt+c",
        "mac": "cmd+l cmd+c",
        "command": "liveServerGuchho.stopServer",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Live Server (Guchho)",
      "properties": {
        "liveServerGuchho.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host to bind the server to"
        },
        "liveServerGuchho.port": {
          "type": "number",
          "default": 5500,
          "description": "Port to bind the server to"
        },
        "liveServerGuchho.root": {
          "type": "string",
          "default": ".",
          "description": "Root directory to serve"
        },
        "liveServerGuchho.openBrowser": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open browser when server starts"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "clean": "guchho clean out ",
    "build": "npm run clean && guchho build && npm run package-platforms",
    "watch": "tsc -watch -p ./",
    "lint": "guchho lint src",
    "download-binaries": "node ./out/scripts/download-binaries.js",
    "prepare-binaries": "node ./out/scripts/prepare-binaries.js",
    "package-platforms": "node ./out/scripts/package-platforms.js",
    "verify-package": "node ./out/scripts/verify-package.js"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.19.0",
    "guchho": "^1.0.9",
    "typescript": "^4.9.5"
  }
}
